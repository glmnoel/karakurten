<div class="kk-dialog">
  <div class="kk-dialog-stat-name">{{statLabel}}</div>
  <div class="kk-dialog-seuil">
    Seuil : <strong>{{statValeur}}</strong> / 10
  </div>

  <div class="kk-dialog-type-label">Type de test :</div>
  <div class="kk-dialog-types">
    <label class="kk-radio-label">
      <input type="radio" name="typeTest" value="simple" checked />
      <span class="kk-radio-btn">⚡ Simple</span>
    </label>
    <label class="kk-radio-label">
      <input type="radio" name="typeTest" value="avantage" />
      <span class="kk-radio-btn">🎯 Avantage</span>
    </label>
    <label class="kk-radio-label">
      <input type="radio" name="typeTest" value="desavantage" />
      <span class="kk-radio-btn">⚠️ Désavantage</span>
    </label>
  </div>
</div>
